# Sanity — create a project at https://www.sanity.io/manage (see README)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01
# Viewer token: used for draft mode / live preview
SANITY_API_READ_TOKEN=
# Editor token: used by `pnpm seed` and by /api/inquiry to store submissions
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# Resend — inquiry notification emails
RESEND_API_KEY=
INQUIRY_TO_EMAIL=communicationsresonance@gmail.com
# Must be an address on a domain verified in Resend
INQUIRY_FROM_EMAIL=

# Public site URL, no trailing slash (used for canonical URLs, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, cookie-free analytics (off when empty). Example: Plausible / Umami script URL + site id
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# Optional: Upstash Redis for distributed rate limiting of /api/inquiry (falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to true to expose the internal /brand-kit review page on the Vercel production deployment
ENABLE_BRAND_KIT=
